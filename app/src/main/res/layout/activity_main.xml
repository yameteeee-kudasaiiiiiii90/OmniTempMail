<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#120E16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Omni Temp Mail"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="-0.03"/>
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_icon_btn"
                android:src="@drawable/ic_refresh"
                android:tint="#0A84FF"
                android:scaleType="centerInside"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>

        <!-- Provider Switcher Segment -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_segmented_bg"
            android:padding="2dp"
            android:layout_marginBottom="10dp">
            <TextView
                android:id="@+id/provMailTm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="mail.tm"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_segment_active"/>
            <TextView
                android:id="@+id/prov1Sec"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="1secmail"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@android:color/transparent"/>
            <TextView
                android:id="@+id/provMailGw"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="mail.gw"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@android:color/transparent"/>
        </LinearLayout>

        <!-- Capsule -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_address_capsule"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingEnd="8dp">
            <TextView
                android:id="@+id/tvEmailAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Initializing..."
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:ellipsize="middle"/>
            <Button
                android:id="@+id/btnCopyAddress"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_ios_blue_btn"
                android:text="Copy"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerLayout"
        android:padding="16dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"/>

        <LinearLayout
            android:id="@+id/layoutEmptyInbox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📭"
                android:textSize="48sp"
                android:layout_marginBottom="10dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Messages Yet"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:text="Incoming emails and verification codes will appear here automatically."
                android:textColor="#8E8E93"
                android:textSize="13sp"
                android:gravity="center"/>
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
